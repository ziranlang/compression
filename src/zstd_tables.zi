Log2 :: (value: s32) -> s32 {
    result: s32 = 0
    while value > 1 { value >>= 1; result += 1 }
    return result
}

FseEntry :: struct { symbol: u8; bits: u8; base: u16 }
FseTable :: struct { entries: [512]FseEntry; log: s32; ready: bool }

// RFC 8878 §4.1. Low-probability symbols occupy the high end. Spread the
// remaining symbols with a step coprime to the power-of-two table size.
FseBuild :: (table: *FseTable, counts: []s32, log: s32) -> bool {
    size := cast(s32)1 << log
    next: [256]s32
    high := size - 1
    for symbol: cast(s64)0..counts.count - 1 {
        frequency := counts[symbol]
        if frequency == -1 {
            table.entries[high].symbol = cast(u8)symbol
            high -= 1
            next[symbol] = 1
        } else { next[symbol] = frequency }
    }
    state: s32 = 0
    step := size / 2 + size / 8 + 3
    for symbol: cast(s64)0..counts.count - 1 {
        for occurrence: cast(s32)1..counts[symbol] {
            table.entries[state].symbol = cast(u8)symbol
            state = (state + step) & (size - 1)
            while state > high { state = (state + step) & (size - 1) }
        }
    }
    if state != 0 { return false }
    for index: cast(s32)0..size - 1 {
        entry := *table.entries[index]
        rank := next[entry.symbol]
        if rank == 0 { return false }
        next[entry.symbol] += 1
        extra := log - Log2(rank)
        entry.bits = cast(u8)extra
        entry.base = cast(u16)((rank << extra) - size)
    }
    table.log = log
    table.ready = true
    return true
}

