using Frame :: #import "zstd_frame"

ZstdUltraLevel :: 22

#scope_file

zstd :: #system_library "zstd";
MaximumLevel :: () -> s32 #foreign zstd "ZSTD_maxCLevel";
CompressBound :: (count: usize) -> usize #foreign zstd "ZSTD_compressBound";
CreateEncoder :: () -> *void #foreign zstd "ZSTD_createCCtx";
FreeEncoder :: (context: *void) -> usize #foreign zstd "ZSTD_freeCCtx";
EncoderParameter :: (context: *void, parameter: s32, value: s32) -> usize #foreign zstd "ZSTD_CCtx_setParameter";
Compress :: (context: *void, output: *u8, capacity: usize, input: *u8, count: usize) -> usize #foreign zstd "ZSTD_compress2";
FindFrameSize :: (input: *u8, count: usize) -> usize #foreign zstd "ZSTD_findFrameCompressedSize";
DictionaryId :: (data: *u8, count: usize) -> u32 #foreign zstd "ZSTD_getDictID_fromDict";
Decompress :: (output: *u8, capacity: usize, input: *u8, count: usize) -> usize #foreign zstd "ZSTD_decompress";
CreateDecoder :: () -> *void #foreign zstd "ZSTD_createDCtx";
FreeDecoder :: (context: *void) -> usize #foreign zstd "ZSTD_freeDCtx";
DecompressWithDictionary :: (context: *void, output: *u8, capacity: usize, input: *u8, count: usize,
    dictionary: *u8, dictionary_size: usize) -> usize #foreign zstd "ZSTD_decompress_usingDict";
IsError :: (status: usize) -> u32 #foreign zstd "ZSTD_isError";
ErrorCode :: (status: usize) -> s32 #foreign zstd "ZSTD_getErrorCode";

CompressionLevel :: 100
WindowLog :: 101
ChecksumFlag :: 201

StreamBuffer :: struct {
    data: *u8
    size: usize
    position: usize
}

StreamMode :: enum s32 { Write; Flush; Finish }
EncoderState :: enum s32 { Closed; Active; Flushing; Finishing; Finished; Failed }
RunEncoder :: (context: *void, output: *StreamBuffer, input: *StreamBuffer,
    mode: StreamMode) -> usize #foreign zstd "ZSTD_compressStream2";
ResetEncoder :: (context: *void, directive: s32) -> usize #foreign zstd "ZSTD_CCtx_reset";
ResetSessionOnly :: 1

FitsSize :: (count: s64) -> bool {
    return count >= 0 && cast(u64)count <= cast(u64)(~cast(usize)0)
}

Overlap :: (left: []u8, right: []u8) -> bool {
    if left.count == 0 || right.count == 0 { return false }
    a := cast(usize)*left[0]
    b := cast(usize)*right[0]
    if a <= b { return b - a < cast(usize)left.count }
    return a - b < cast(usize)right.count
}

// Values from the public libzstd error enumeration, stable since 1.3.1.
Result :: (status: usize) -> ZstdResult {
    if IsError(status) == 0 { return .{count = cast(s64)status} }
    code := ErrorCode(status)
    if code == 22 { return .{problem = .Checksum} }
    if code == 30 || code == 32 { return .{problem = .Dictionary} }
    if code == 64 { return .{problem = .Allocation} }
    if code == 70 { return .{problem = .OutputLimit} }
    if code == 72 { return .{problem = .Truncated} }
    return .{problem = .Format}
}

SkippableFrame :: (input: []u8) -> bool {
    return input.count >= 4 && (input[0] & cast(u8)0xf0) == 0x50 &&
        input[1] == 0x2a && input[2] == 0x4d && input[3] == 0x18
}

#scope_export

// Each encoder owns one context. Use it from one caller at a time and free it
// when done. Reset reuses the context and its settings for a new frame.
ZstdEncoder :: struct {
    context: *void
    state: EncoderState
}

ZstdEncoderOpen :: struct {
    encoder: ZstdEncoder
    problem: ZstdProblem
}

ZstdEncoderStep :: struct {
    consumed: s64
    written: s64
    done: bool
    problem: ZstdProblem
}

ZstdOpenEncoder :: (level: s32, window_log: s32) -> ZstdEncoderOpen {
    if level < 1 || level > ZstdUltraLevel || window_log < 10 || window_log > 30 {
        return .{problem = .InvalidArgument}
    }
    if level > MaximumLevel() { return .{problem = .Backend} }
    context := CreateEncoder()
    if context == null { return .{problem = .Allocation} }
    if IsError(EncoderParameter(context, CompressionLevel, level)) != 0 ||
        IsError(EncoderParameter(context, WindowLog, window_log)) != 0 ||
        IsError(EncoderParameter(context, ChecksumFlag, 1)) != 0 {
        unused FreeEncoder(context)
        return .{problem = .Backend}
    }
    return .{encoder = .{context = context, state = .Active}}
}

ZstdResetEncoder :: (encoder: *ZstdEncoder) -> ZstdProblem {
    if encoder == null || encoder.context == null { return .InvalidArgument }
    if IsError(ResetEncoder(encoder.context, ResetSessionOnly)) != 0 {
        encoder.state = .Failed
        return .Backend
    }
    encoder.state = .Active
    return .None
}

ZstdFreeEncoder :: (encoder: *ZstdEncoder) {
    if encoder == null || encoder.context == null { return }
    unused FreeEncoder(encoder.context)
    encoder.context = null
    encoder.state = .Closed
}

#scope_file
StreamStep :: (encoder: *ZstdEncoder, input: []u8, output: []u8, mode: StreamMode) -> ZstdEncoderStep {
    if encoder == null || encoder.context == null ||
        !FitsSize(input.count) || !FitsSize(output.count) || Overlap(input, output) {
        return .{problem = .InvalidArgument}
    }
    if output.count == 0 { return .{problem = .OutputLimit} }
    if encoder.state != .Active && !(mode == .Flush && encoder.state == .Flushing) &&
        !(mode == .Finish && encoder.state == .Finishing) {
        return .{problem = .InvalidArgument}
    }
    source: StreamBuffer = .{
        data = ifx input.count == 0 then null else *input[0],
        size = cast(usize)input.count
    }
    destination: StreamBuffer = .{data = *output[0], size = cast(usize)output.count}
    status := Result(RunEncoder(encoder.context, *destination, *source, mode))
    if status.problem != .None {
        encoder.state = .Failed
        return .{problem = status.problem}
    }
    done := ifx mode == .Write then source.position == source.size else status.count == 0
    if mode == .Flush { encoder.state = ifx done then .Active else .Flushing }
    if mode == .Finish { encoder.state = ifx done then .Finished else .Finishing }
    return .{consumed = cast(s64)source.position, written = cast(s64)destination.position, done = done}
}

#scope_export
// Pass the unconsumed tail again when done is false. Retain the written prefix
// of each successful step before reusing the output buffer.
ZstdWriteEncoder :: (encoder: *ZstdEncoder, input: []u8, output: []u8) -> ZstdEncoderStep {
    return StreamStep(encoder, input, output, .Write)
}

ZstdFlushEncoder :: (encoder: *ZstdEncoder, output: []u8) -> ZstdEncoderStep {
    empty: []u8
    return StreamStep(encoder, empty, output, .Flush)
}

ZstdFinishEncoder :: (encoder: *ZstdEncoder, output: []u8) -> ZstdEncoderStep {
    empty: []u8
    return StreamStep(encoder, empty, output, .Finish)
}

ZstdEncodeBound :: (input_count: s64) -> ZstdResult {
    if !FitsSize(input_count) { return .{problem = .InvalidArgument} }
    bound := CompressBound(cast(usize)input_count)
    if IsError(bound) != 0 || cast(u64)bound > 0x7fffffffffffffff { return .{problem = .InvalidArgument} }
    return .{count = cast(s64)bound}
}

// Writes one standard frame with its content size and checksum recorded.
// INPUT and OUTPUT must be disjoint. OUTPUT is usable only on success.
ZstdEncode :: (input: []u8, output: []u8, level: s32 = ZstdUltraLevel) -> ZstdResult {
    if level < 1 || level > ZstdUltraLevel || !FitsSize(input.count) || !FitsSize(output.count) ||
        Overlap(input, output) { return .{problem = .InvalidArgument} }
    if output.count == 0 { return .{problem = .OutputLimit} }
    if level > MaximumLevel() { return .{problem = .Backend} }
    context := CreateEncoder()
    if context == null { return .{problem = .Allocation} }
    defer { unused FreeEncoder(context) }
    if IsError(EncoderParameter(context, CompressionLevel, level)) != 0 ||
        IsError(EncoderParameter(context, ChecksumFlag, 1)) != 0 { return .{problem = .Backend} }
    return Result(Compress(context, *output[0], cast(usize)output.count,
        ifx input.count == 0 then null else *input[0], cast(usize)input.count))
}

// Decodes exactly one standard frame into caller storage. MAX_WINDOW is an
// exact byte limit checked before libzstd runs. OUTPUT is usable only on success.
ZstdDecode :: (input: []u8, output: []u8, max_window: u64) -> ZstdResult {
    dictionary: []u8
    return ZstdDecodeWithDictionary(input, output, max_window, dictionary)
}

// Decode a sequence of dictionary-free frames into one bounded output. A
// skippable frame contributes no output. Discard the output on any error.
ZstdDecodeFrames :: (input: []u8, output: []u8, max_window: u64) -> ZstdResult {
    if !FitsSize(input.count) || !FitsSize(output.count) || Overlap(input, output) {
        return .{problem = .InvalidArgument}
    }
    if input.count == 0 {
        return .{problem = .Truncated}
    }
    offset: s64 = 0
    declared_capacity := cast(u64)output.count
    while offset < input.count {
        remaining := input[offset:]
        if !SkippableFrame(remaining) {
            header := Frame.ZstdReadHeader(remaining)
            if header.problem != .None {
                return .{problem = header.problem}
            }
            if header.window > max_window {
                return .{problem = .WindowLimit}
            }
            if header.dictionary_id != 0 {
                return .{problem = .Dictionary}
            }
            if header.has_content_size {
                if header.content_size > declared_capacity {
                    return .{problem = .OutputLimit}
                }
                declared_capacity -= header.content_size
            }
        }
        size := Result(FindFrameSize(*remaining[0], cast(usize)remaining.count))
        if size.problem != .None {
            return size
        }
        offset += size.count
    }
    destination := ifx output.count == 0 then null else *output[0]
    return Result(Decompress(destination, cast(usize)output.count, *input[0], cast(usize)input.count))
}

// For frames with a dictionary ID, the formatted dictionary must carry that ID.
ZstdDecodeWithDictionary :: (input: []u8, output: []u8, max_window: u64, dictionary: []u8) -> ZstdResult {
    if !FitsSize(input.count) || !FitsSize(output.count) || !FitsSize(dictionary.count) ||
        Overlap(input, output) || Overlap(dictionary, output) { return .{problem = .InvalidArgument} }
    header := Frame.ZstdReadHeader(input)
    if header.problem != .None { return .{problem = header.problem} }
    if header.window > max_window { return .{problem = .WindowLimit} }
    if header.has_content_size && header.content_size > cast(u64)output.count { return .{problem = .OutputLimit} }
    if (header.dictionary_id != 0) != (dictionary.count != 0) { return .{problem = .Dictionary} }
    if dictionary.count != 0 && DictionaryId(*dictionary[0], cast(usize)dictionary.count) != header.dictionary_id {
        return .{problem = .Dictionary}
    }
    input_size := cast(usize)input.count
    size := Result(FindFrameSize(*input[0], input_size))
    if size.problem != .None { return size }
    if size.count != input.count { return .{problem = .Trailing} }
    destination := ifx output.count == 0 then null else *output[0]
    capacity := cast(usize)output.count
    if dictionary.count == 0 { return Result(Decompress(destination, capacity, *input[0], input_size)) }
    context := CreateDecoder()
    if context == null { return .{problem = .Allocation} }
    defer { unused FreeDecoder(context) }
    return Result(DecompressWithDictionary(context, destination, capacity, *input[0], input_size,
        *dictionary[0], cast(usize)dictionary.count))
}
